{
  "doctype": "Print Format",
  "name": "Signed Proof of Delivery",
  "module": "VMS",
  "doc_type": "Proof of Delivery",
  "standard": "Yes",
  "print_format_type": "Jinja",
  "html": "\n<div class=\"pod-print-container\" style=\"padding: 20px; font-family: sans-serif;\">\n    <div style=\"border-bottom: 2px solid #222; padding-bottom: 10px; margin-bottom: 20px;\">\n        <h2 style=\"margin: 0; color: #1e3a8a;\">KEERTHI GROUPS HARDWARE</h2>\n        <h4 style=\"margin: 5px 0 0 0; color: #555;\">Official Proof of Delivery (POD) Certificate</h4>\n    </div>\n    \n    <table style=\"width: 100%; margin-bottom: 20px;\">\n        <tr>\n            <td><strong>POD No:</strong> {{ doc.name }}</td>\n            <td><strong>Delivery Trip:</strong> {{ doc.delivery_trip }}</td>\n        </tr>\n        <tr>\n            <td><strong>Customer:</strong> {{ doc.customer_name or doc.customer }}</td>\n            <td><strong>Date/Time:</strong> {{ doc.server_timestamp }}</td>\n        </tr>\n        <tr>\n            <td><strong>Receiver Name:</strong> {{ doc.receiver_name }}</td>\n            <td><strong>Receiver Phone:</strong> {{ doc.receiver_phone or 'N/A' }}</td>\n        </tr>\n    </table>\n    \n    <h3>Delivered Materials</h3>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\" border=\"1\">\n        <thead>\n            <tr style=\"background: #f1f5f9;\">\n                <th style=\"padding: 8px;\">Item Code</th>\n                <th style=\"padding: 8px;\">Item Name</th>\n                <th style=\"padding: 8px;\">Allocated</th>\n                <th style=\"padding: 8px;\">Delivered</th>\n                <th style=\"padding: 8px;\">Damaged</th>\n                <th style=\"padding: 8px;\">Short</th>\n                <th style=\"padding: 8px;\">Rejected</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td style=\"padding: 6px;\">{{ item.item_code }}</td>\n                <td style=\"padding: 6px;\">{{ item.item_name }}</td>\n                <td style=\"padding: 6px; text-align: right;\">{{ item.allocated_qty }}</td>\n                <td style=\"padding: 6px; text-align: right; font-weight: bold; color: green;\">{{ item.delivered_qty }}</td>\n                <td style=\"padding: 6px; text-align: right; color: red;\">{{ item.damaged_qty }}</td>\n                <td style=\"padding: 6px; text-align: right; color: orange;\">{{ item.short_qty }}</td>\n                <td style=\"padding: 6px; text-align: right; color: red;\">{{ item.rejected_qty }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <div style=\"margin-top: 30px; display: flex; justify-content: space-between;\">\n        <div style=\"width: 45%; border: 1px dashed #aaa; padding: 10px; min-height: 100px;\">\n            <p style=\"margin: 0; font-size: 12px; color: #777;\">Customer Digital Signature:</p>\n            {% if doc.signature_data %}\n            <img src=\"{{ doc.signature_data }}\" style=\"max-height: 80px; max-width: 100%;\" />\n            {% else %}\n            <p style=\"font-style: italic; color: #999;\">Signed electronically on mobile</p>\n            {% endif %}\n        </div>\n        <div style=\"width: 45%; border: 1px solid #ddd; padding: 10px;\">\n            <p style=\"margin: 0 0 5px 0; font-size: 12px; font-weight: bold;\">Cryptographic Audit Seal:</p>\n            <div style=\"font-family: monospace; font-size: 10px; word-break: break-all; background: #f8fafc; padding: 5px;\">\n                {{ doc.audit_hash or 'SHA-256 Verified at Server' }}\n            </div>\n            <p style=\"font-size: 10px; color: #666; margin-top: 5px;\">Timestamp: {{ doc.server_timestamp }}</p>\n        </div>\n    </div>\n</div>\n"
}