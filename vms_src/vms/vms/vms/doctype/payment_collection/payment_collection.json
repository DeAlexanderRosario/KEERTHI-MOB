{
  "name": "Payment Collection",
  "doctype": "DocType",
  "module": "VMS",
  "is_submittable": 1,
  "autoname": "format:PAY-COL-.YYYY.-.#####",
  "naming_rule": "Expression",
  "fields": [
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "customer_name",
      "label": "Customer Name",
      "fieldtype": "Data",
      "fetch_from": "customer.customer_name",
      "read_only": 1
    },
    {
      "fieldname": "sales_agent",
      "label": "Field Sales Agent",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "collection_date",
      "label": "Collection Date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "amount",
      "label": "Amount Collected",
      "fieldtype": "Currency",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "mode_of_payment",
      "label": "Payment Mode",
      "fieldtype": "Link",
      "options": "Mode of Payment",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "transaction_reference",
      "label": "Cheque / UTR / Reference No",
      "fieldtype": "Data"
    },
    {
      "fieldname": "bank_name",
      "label": "Drawn Bank",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nVerified\nPayment Entry Created\nRejected",
      "default": "Draft",
      "allow_on_submit": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "section_allocations",
      "label": "Invoice Allocations",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "allocations",
      "label": "Invoices",
      "fieldtype": "Table",
      "options": "Payment Collection Allocation"
    },
    {
      "fieldname": "section_evidence",
      "label": "Evidence & Verification",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "evidence_attachment",
      "label": "Cheque/Receipt Photo",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "remarks",
      "label": "Agent Remarks",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "verified_by",
      "label": "Verified By (Accounts)",
      "fieldtype": "Link",
      "options": "User",
      "allow_on_submit": 1,
      "read_only": 1
    },
    {
      "fieldname": "verification_timestamp",
      "label": "Verified At",
      "fieldtype": "Datetime",
      "allow_on_submit": 1,
      "read_only": 1
    },
    {
      "fieldname": "verification_notes",
      "label": "Accounts Notes",
      "fieldtype": "Small Text",
      "allow_on_submit": 1
    },
    {
      "fieldname": "rejection_reason",
      "label": "Rejection Reason",
      "fieldtype": "Small Text",
      "allow_on_submit": 1,
      "read_only": 1
    },
    {
      "fieldname": "payment_entry_reference",
      "label": "ERPNext Payment Entry",
      "fieldtype": "Link",
      "options": "Payment Entry",
      "allow_on_submit": 1,
      "read_only": 1,
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "Field Sales Agent",
      "read": 1,
      "write": 1,
      "create": 1,
      "if_owner": 1,
      "submit": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1
    },
    {
      "role": "Accounts User",
      "read": 1,
      "write": 1,
      "submit": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}
