      "options": "Pending\nArrived\nDelivered\nPartially Delivered\nFailed\nRescheduled",
      "default": "Pending",
      "allow_on_submit": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "arrival_time",
      "label": "Arrival Time",
