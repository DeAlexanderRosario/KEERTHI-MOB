      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "customer_name",
      "label": "Customer Name",
      "fieldtype": "Data",
      "fetch_from": "customer.customer_name",
      "read_only": 1
    },
    {
      "fieldname": "address",
      "label": "Delivery Address",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "contact_phone",
      "label": "Contact Phone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
