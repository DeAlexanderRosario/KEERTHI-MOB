    },
    {
      "fieldname": "arrival_lat",
      "label": "Latitude",
      "fieldtype": "Float",
      "allow_on_submit": 1,
      "read_only": 1
    },
    {
      "fieldname": "arrival_lng",
      "label": "Longitude",
      "fieldtype": "Float",
      "allow_on_submit": 1,
      "read_only": 1
    },
    {
      "fieldname": "failure_reason",
      "label": "Failure Reason",
      "fieldtype": "Small Text",
      "allow_on_submit": 1
    },
    {
      "fieldname": "rescheduled_date",
      "label": "Requested Reschedule Date",
      "fieldtype": "Date",
      "allow_on_submit": 1
    },
    {
      "fieldname": "reschedule_reason",
      "label": "Reschedule Reason",
      "fieldtype": "Small Text",
      "allow_on_submit": 1
    },
    {
      "fieldname": "pod_reference",
      "label": "POD Reference",
      "fieldtype": "Link",
