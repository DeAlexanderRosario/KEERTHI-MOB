{
  "name": "Customer Onboarding Request",
  "doctype": "DocType",
  "module": "VMS",
  "is_submittable": 1,
  "autoname": "format:ONBOARD-.YYYY.-.#####",
  "naming_rule": "Expression",
  "fields": [
    {
      "fieldname": "shop_name",
      "label": "Shop / Enterprise Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "owner_name",
      "label": "Proprietor / Owner Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "tax_id",
      "label": "GSTIN / Tax ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "mobile_no",
      "label": "Mobile No",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "email",
      "label": "Email Address",
      "fieldtype": "Data"
    },
    {
      "fieldname": "territory",
      "label": "Territory",
      "fieldtype": "Link",
      "options": "Territory",
      "reqd": 1
    },
    {
      "fieldname": "proposed_credit_limit",
      "label": "Proposed Credit Limit",
      "fieldtype": "Currency",
      "default": 0
    },
    {
      "fieldname": "primary_address",
      "label": "Primary Address",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "sales_agent",
      "label": "Submitted By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending Approval\nApproved\nRejected\nChanges Requested",
      "default": "Pending Approval",
      "allow_on_submit": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "rejection_reason",
      "label": "Rejection / Change Request Reason",
      "fieldtype": "Small Text",
      "allow_on_submit": 1
    },
    {
      "fieldname": "created_customer",
      "label": "ERPNext Customer Created",
      "fieldtype": "Link",
      "options": "Customer",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "Field Sales Agent",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "submit": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}
