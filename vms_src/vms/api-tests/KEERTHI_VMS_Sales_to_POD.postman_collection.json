            "key": "Authorization",
            "value": "token {{warehouse_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "allocation_name",
              "value": "{{allocation}}",
              "type": "text"
            },
            {
              "key": "item_code",
              "value": "{{item_code}}",
              "type": "text"
            },
            {
              "key": "picked_qty",
              "value": "{{order_qty}}",
              "type": "text"
            },
            {
              "key": "bin_location",
              "value": "API-FLOW-TEST",
              "type": "text"
            },
            {
              "key": "sales_order",
              "value": "{{sales_order}}",
