  "item": [
    {
      "name": "1. Sales Agent — Create Shop Visit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{sales_agent_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "customer",
              "value": "{{customer}}",
              "type": "text"
            },
            {
              "key": "purpose",
              "value": "Sales Pitch",
              "type": "text"
            },
            {
              "key": "notes",
              "value": "API flow test only",
              "type": "text"
            },
            {
              "key": "items",
              "value": "[{\"item_code\":\"{{item_code}}\",\"order_qty\":{{order_qty}},\"stock_level_at_shop\":0,\"customer_interest\":\"High\"}]",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/vms.api.field_sales.create_shop_visit",
        "description": "Order quantities are saved on the Shop Visit item rows."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Shop Visit created', function () { pm.response.to.have.status(200); });",
              "const r=pm.response.json().message; pm.expect(r.status).to.eql('success'); pm.environment.set('shop_visit', r.visit_name);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Sales Agent — Create Sales Order draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{sales_agent_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "customer",
              "value": "{{customer}}",
              "type": "text"
            },
            {
              "key": "items_json",
              "value": "[{\"item_code\":\"{{item_code}}\",\"qty\":{{order_qty}},\"rate\":0}]",
              "type": "text"
            },
            {
              "key": "delivery_date",
              "value": "{{delivery_date}}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/vms.api.field_sales.create_sales_order",
        "description": "The API ignores the supplied rate and uses the customer price list Item Price."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r=pm.response.json().message; pm.expect(r.status).to.eql('success'); pm.environment.set('sales_order', r.sales_order);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Sales Manager — Read Sales Order lines",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{sales_manager_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "doctype",
              "value": "Sales Order",
              "type": "text"
            },
            {
              "key": "name",
              "value": "{{sales_order}}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/frappe.client.get",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const so=pm.response.json().message; pm.expect(so.name).to.eql(pm.environment.get('sales_order')); pm.expect(so.items.length).to.be.above(0); pm.environment.set('sales_order_item', so.items[0].name);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Sales Manager — Submit Sales Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{sales_manager_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "doc",
              "value": "{\"doctype\":\"Sales Order\",\"name\":\"{{sales_order}}\"}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/frappe.client.submit",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const so=pm.response.json().message; pm.expect(so.docstatus).to.eql(1);"
            ]
          }
        }
      ]
    },
