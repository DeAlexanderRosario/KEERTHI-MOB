          ]
        },
        "url": "{{base_url}}/api/method/vms.api.dispatch.approve_dispatch",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r=pm.response.json().message; pm.expect(r.status).to.eql('success'); pm.environment.set('trip_name',r.trip_name);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Driver — List Assigned Active Trips",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{driver_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": []
        },
        "url": "{{base_url}}/api/method/vms.api.driver_portal.get_my_trips",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const trips=pm.response.json().message; const t=trips.find(x=>x.name===pm.environment.get('trip_name')); pm.expect(t,'New dispatched trip should be assigned to this driver').to.exist;"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Driver — Start Trip",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{driver_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "trip_name",
              "value": "{{trip_name}}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/vms.api.driver_portal.start_trip",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.json().message.status).to.eql('success');"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Driver — Load Trip Stops and Items",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{driver_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "trip_name",
              "value": "{{trip_name}}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/vms.api.driver_portal.get_trip_details",
        "description": "This test assumes one stop for the selected customer. The POD form can auto-fill the same trip-linked fields."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const trip=pm.response.json().message; pm.expect(trip.items.length).to.be.above(0); const stop=trip.stops.find(s=>s.customer===pm.environment.get('customer')&&['Pending','Arrived'].includes(s.status)); pm.expect(stop,'Expected test customer stop').to.exist; pm.environment.set('stop_name',stop.name); pm.environment.set('stop_sequence',String(stop.stop_sequence)); const lines=trip.items.filter(i=>String(i.stop_reference||'')===String(stop.stop_sequence)||String(i.stop_reference||'')===String(stop.name)); pm.expect(lines.length).to.be.above(0); const pods=lines.map(i=>({sales_order:i.sales_order,sales_order_item:i.sales_order_item,item_code:i.item_code,allocated_qty:Number(i.allocated_qty),delivered_qty:Number(i.allocated_qty),damaged_qty:0,short_qty:0,rejected_qty:0})); pm.environment.set('pod_items_json',JSON.stringify(pods));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Driver — Record Arrival",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{driver_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "trip_name",
              "value": "{{trip_name}}",
              "type": "text"
            },
            {
              "key": "stop_name",
              "value": "{{stop_name}}",
              "type": "text"
            },
            {
              "key": "lat",
              "value": "{{lat}}",
              "type": "text"
            },
            {
              "key": "lng",
              "value": "{{lng}}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/vms.api.driver_portal.record_arrival",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.json().message.status).to.eql('success');"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional — Upload Private POD Test Photo",
      "item": [
        {
          "name": "Driver — Upload a test image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "token {{driver_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "is_private",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "url": "{{base_url}}/api/method/upload_file",
            "description": "Optional: select a harmless test image in Postman. Keep the upload private so the POD controller can hash the file bytes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Private POD image uploaded', function () { pm.response.to.have.status(200); });",
                  "const r=pm.response.json().message; pm.expect(r.file_url).to.include('/private/files/'); pm.environment.set('pod_photo_url',r.file_url);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "14. Driver — Submit POD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{driver_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "trip_name",
              "value": "{{trip_name}}",
              "type": "text"
            },
            {
              "key": "stop_name",
              "value": "{{stop_name}}",
              "type": "text"
            },
            {
              "key": "receiver_name",
              "value": "{{receiver_name}}",
              "type": "text"
            },
            {
              "key": "receiver_phone",
              "value": "{{receiver_phone}}",
              "type": "text"
            },
            {
              "key": "items_json",
              "value": "{{pod_items_json}}",
              "type": "text"
            },
            {
              "key": "photos_json",
              "value": "{{pod_photos_json}}",
              "type": "text"
            },
            {
              "key": "lat",
              "value": "{{lat}}",
              "type": "text"
            },
            {
              "key": "lng",
              "value": "{{lng}}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/vms.api.driver_portal.submit_pod",
        "description": "Receiver name and real delivery quantities/evidence must be supplied by the test driver."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const url=pm.environment.get('pod_photo_url'); pm.environment.set('pod_photos_json',url?JSON.stringify([{category:'Delivery Evidence',photo_url:url,remarks:'Test-site evidence'}]):'[]');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r=pm.response.json().message; pm.expect(r.status).to.eql('success'); pm.expect(r.audit_hash).to.match(/^[a-f0-9]{64}$/); pm.environment.set('pod_name',r.pod_name);"
            ]
          }
        }
      ]
    }
  ]
}
