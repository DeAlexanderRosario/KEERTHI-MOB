            },
            {
              "key": "driver",
              "value": "{{driver}}",
              "type": "text"
            },
            {
              "key": "route",
              "value": "{{route}}",
              "type": "text"
            },
            {
              "key": "delivery_date",
              "value": "{{delivery_date}}",
              "type": "text"
            },
            {
              "key": "orders_json",
              "value": "[{\"sales_order\":\"{{sales_order}}\",\"sales_order_item\":\"{{sales_order_item}}\",\"customer\":\"{{customer}}\",\"item_code\":\"{{item_code}}\",\"allocated_qty\":{{order_qty}},\"warehouse\":\"{{warehouse}}\"}]",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/method/vms.api.dispatch.create_or_update_allocation",
        "description": "Requires a positive vehicle payload capacity and an active mapped driver."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r=pm.response.json().message; pm.expect(r.status).to.eql('success'); pm.environment.set('allocation', r.allocation_name);"
            ]
          }
        }
      ]
    },
